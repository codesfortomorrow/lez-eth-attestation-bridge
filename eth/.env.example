# Copy to eth/.env and fill in. Never commit eth/.env.
NETWORK=sepolia

# Execution RPC that supports eth_getProof (Alchemy / Infura / QuickNode / own node)
EXEC_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Beacon API base URL with light-client routes (/eth/v1/beacon/light_client/...)
# e.g. your own Lighthouse/Nimbus on :5052, or a provider's beacon endpoint
BEACON_API=http://localhost:5052

# Deployer key for TestUSD (Sepolia test wallet only)
PRIVATE_KEY=0x...

# Filled in as you go
TOKEN=
HOLDER=

# Only for `npm run send` (testing helper: send tUSD to any address)
# SEND_TO=0x...
# AMOUNT=1000

# Optional
# NETWORK=sepolia          # folder name under vectors/
# DEAL_AMOUNT=1000         # tUSD escrowed by `npm run escrow`
# LEZ_CHAIN_ID=0x4c455a    # LEZ zone id bound into bridge commitments
